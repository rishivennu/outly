# PostHog product analytics (1149). Tracking runs only after a visitor accepts analytics cookies,
# never with Do Not Track on and never on /admin. Built-in defaults (lib/analytics/config.ts) point at
# the US Cloud project; set these to override.
# Public project key (phc_...). Unset = built-in default; set to an empty value to switch tracking off.
# NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key
# Ingest host: https://us.i.posthog.com (default) or https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Server only. Personal API key with query:read, for Admin > Analytics. No default.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=735656
# App host for the Query API and "Open in PostHog". Derived from NEXT_PUBLIC_POSTHOG_HOST when unset.
POSTHOG_APP_HOST=https://us.posthog.com
