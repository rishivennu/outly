// Source of truth. Production DB = Supabase Postgres (DATABASE_URL pooled :6543, DIRECT_URL :5432 for migrations).
// `bun run scripts/prisma-provider.mjs` writes schema.prisma with the provider from DATABASE_PROVIDER.
// No enums / Json so the same schema runs on SQLite (dev) and PostgreSQL (prod). Status values are typed in lib/domain.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "__PROVIDER__"
  url      = env("DATABASE_URL")
  __DIRECT_URL__
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String? // only for AUTH_PROVIDER=local; Supabase Auth owns passwords otherwise
  authId       String?  @unique // Supabase auth.users.id
  avatar       String?
  timezone     String   @default("Asia/Kolkata")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lastActiveAt DateTime?
  lastSeenAt   DateTime? // presence heartbeat (1037), written at most once a minute; "online" = seen in the last 5 minutes
  alertPrefs   String? // JSON { spike, spikeX, failed, email } custom alerts (1037); null = defaults
  notifyPrefs  String? // JSON notification settings (1118): events, reminder lead, channels, quiet hours; null = defaults
  rzpCustomerId    String? // Razorpay customer (1118): saved cards are tokens Razorpay keeps against it; Outlly stores no card data
  defaultCardToken String? // the saved-card token marked default (Razorpay has no default of its own)
  referralCode String?   @unique // share link /signup?ref={code} (old /r/{code} still works)
  referredById String? // who invited this user (1052: the friend, not the sharer, earns a Creator month on their first payment)
  weeklyReport Boolean   @default(true) // Monday summary email
  lastReportAt DateTime?
  postingGoal  Int       @default(3) // posts per week the creator aims for (0 = no goal)
  nudgeAt      DateTime? // last "you're behind this week" nudge
  winbackAt    DateTime? // last win-back email after going quiet
  signupSource String? // first campaign link they arrived on: "source/medium/campaign", "referral" or "direct"
  totpSecret    String? // authenticator key (base32), AES-256-GCM encrypted. Saved at setup; live once totpEnabledAt is set
  totpEnabledAt DateTime?
  totpLastStep  Int? // last accepted 30-second step, so one code can't be used twice
  recoveryCodes String? // JSON array of hashed one-time recovery codes
  tokenVersion  Int     @default(0) // bumped by "sign out everywhere" / password change; sessions carry it as `v`
  emailVerifiedAt DateTime? // the inbox was proven: Google sign-in, an emailed code, or the founding link (1036)
  emailVerifiedFor String? // the exact address that was proven; a changed email is unproven again
  phone           String?   @unique // E.164, only ever saved once a WhatsApp code proved it
  phoneVerifiedAt DateTime?
  foundingNo      Int?      @unique // founding member number, 1..limit (null = not a founding member)
  foundingAt      DateTime?
  foundingPct     Int? // lifetime discount locked in when the seat was claimed
  foundingKey     String?   @unique // one seat per real inbox (Gmail dots and +tags folded away)
  foundingRetiredNo Int? // a revoked member's number, kept so it is never handed out again
  foundingPromoAt DateTime? // 1067: the one-time founding invitation on Home was closed (kept on every device)
  // Where they last used Outlly from (1053). Approximate: read from the network (Cloudflare/Vercel IP
  // headers), never an address, and a VPN can place them anywhere. Written only when it changes.
  locCountry      String? // ISO 3166-1 alpha-2
  locRegion       String?
  locCity         String?
  locVia          String? // "cloudflare" | "vercel" | "tor"
  locAt           DateTime?
  // 1120 creator profile card. All optional: the card shows nothing the creator didn't add or connect.
  handle       String?   @unique // public @handle: lowercase letters, digits, dots and underscores, 3 to 30
  bio          String? // up to 160 characters
  niche        String? // up to 40 characters, e.g. "Travel" (optional)
  banner       String? // uploaded cover, "/api/u/img/<name>"; null = the theme's own cover art
  profileLinks String? // JSON { hidden: accountId[], links: { platform, url }[] } (lib/profile-card-core.ts)

  socialAccounts SocialAccount[]
  aiUsage        AiUsage[]
  media          Media[]
  posts          Post[]
  subscriptions  Subscription[]
  payments       Payment[]
  invoices       Invoice[]
  tickets        Ticket[]
  activity       UserActivityDay[]
  teamMembers    TeamMember[]      @relation("TeamOwner")
  seats          TeamMember[]      @relation("TeamSeat")
  notices        Notice[]
  notifyEvents     NotifyEvent[]
  notifyDeliveries NotifyDelivery[]
  snippets       Snippet[]
  ideas          Idea[]
  featureUses FeatureUse[]
  pushDevices PushDevice[]
  webPushSubs WebPushSub[]
  dmThreads   DmThread[]
  betaIssued  BetaCode?  @relation("BetaIssued")
  betaRedeemed BetaCode? @relation("BetaRedeemed")
  creditNotes  CreditNote[]
  pipAccess    PipAccessLog[]
  pipChats     PipConversation[]
  planGrants   PlanGrant[]
  referralsMade Referral[] @relation("ReferralsMade")
  referral      Referral?  @relation("ReferralReceived")
  trustedDevices TrustedDevice[]
  sessions       UserSession[]
  topUps         TopUp[]
  experimentEvents ExperimentEvent[]
  surveyResponses SurveyResponse[]
  cancelFeedback  CancelFeedback[]
  campaignEvents  CampaignEvent[] // 1122

  @@index([lastSeenAt])
}

/// A browser the person chose to remember at sign-in (1053). The cookie holds `id.secret`; only a hash of
/// the secret is stored. While it is valid, sign-in on that browser skips the second step (the password or
/// email code is still asked). Deleting the row signs that browser out (sessions carry its id as `td`).
model TrustedDevice {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretHash   String
  tokenVersion Int // a password change or "sign out everywhere" bumps the user's version and ends it
  label        String // "Chrome on Android"
  place        String? // approximate, from the network, at the time it was remembered
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())
  expiresAt    DateTime

  @@index([userId])
}

/// A signed-in browser or app (1080), for Settings > Active sessions. The session cookie carries its id as
/// `sid`; deleting the row signs that browser out on its next request. Cookies from before 1080 have no `sid`
/// and keep working until "Sign out other sessions" (a token version bump) or their own expiry ends them.
model UserSession {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String // "Chrome on Windows"
  place      String? // approximate, from the network, at sign-in
  app        Boolean  @default(false) // signed in through the Outlly app
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now()) // touched at most every 5 minutes
  expiresAt  DateTime

  @@index([userId])
}

/// One-time sign-in codes sent by email. Only a keyed hash of the code is stored; no link to User, so a
/// request for an unknown address looks exactly like one for a real account.
model OtpCode {
  id        String    @id @default(cuid())
  email     String
  purpose   String // login | reset | phone | 2fa. `email` holds the address, or wa:/add:/2fa: keys for WhatsApp codes
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
}

model SocialAccount {
  id             String    @id @default(cuid())
  userId         String
  platform       String // instagram | youtube | x | tiktok | facebook | linkedin | threads
  platformUserId String
  username       String
  displayName    String?
  avatar         String?
  accessToken    String // AES-256-GCM encrypted, never sent to the client
  refreshToken   String?
  tokenExpiresAt DateTime?
  metadata       String? // JSON string
  status         String    @default("connected") // connected | needs_reconnect | disconnected
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  targets   PostTarget[]
  dmThreads DmThread[]
  snapshots AccountSnapshot[] // 1140: daily follower / post / view history
  syncState AccountSyncState? // 1140: when the background metric sync last ran for this account

  @@unique([userId, platform, platformUserId])
  @@index([userId])
}

model Media {
  id               String   @id @default(cuid())
  userId           String
  originalFilename String
  storageKey       String
  thumbnailKey     String?
  mimeType         String
  size             Int
  duration         Float?
  width            Int?
  height           Int?
  status           String   @default("uploaded") // uploading | uploaded | processing | ready | failed
  createdAt        DateTime @default(now())

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts     Post[]
  postItems PostMedia[] // 1131: slides of photo / carousel / story posts

  @@index([userId])
}

model Post {
  id          String    @id @default(cuid())
  userId      String
  mediaId     String
  title       String? // internal working title
  story       String? // creator's description of the video
  hook        String? // chosen hook
  status      String    @default("draft") // draft | scheduled | publishing | published | partial | failed
  requireApproval Boolean @default(false) // publishing is blocked until a reviewer approves
  scheduledAt DateTime?
  publishedAt DateTime?
  launchedAt  DateTime? // first time it left draft (published or scheduled): what plan post limits count
  coverKey    String? // 1083: the creator's own cover image (JPEG), sent to the platforms that take one
  format      String    @default("video") // 1131: video | photo | carousel | story
  editedAt    DateTime? // last change to the copy (1037); an approval older than this no longer counts
  editedBy    String? // who made that change (name), shown in the draft's activity
  editedById  String? // their user id: nobody but the owner approves their own change
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  media   Media        @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  targets PostTarget[]
  reviews ReviewRequest[]
  notes   PostNote[]
  items   PostMedia[]

  @@index([userId, status])
  @@index([userId, scheduledAt])
  // 1091: the Content library lists newest edit first, page by page.
  @@index([userId, updatedAt])
}

/// 1131: the ordered media of a photo, carousel or story post (position 0 is also Post.mediaId).
/// A video post (format "video") has no rows here and uses Post.mediaId alone.
model PostMedia {
  id       String  @id @default(cuid())
  postId   String
  mediaId  String
  position Int
  altText  String?

  post  Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([postId, position])
  @@index([mediaId])
}

model PostTarget {
  id              String    @id @default(cuid())
  postId          String
  socialAccountId String?
  platform        String
  title           String?
  caption         String?
  description     String?
  hashtags        String? // space separated
  firstComment    String? // posted as the first comment once the post is live (Instagram, YouTube; a reply on X)
  firstCommentId  String? // the platform's id for that comment, once posted
  firstCommentError String? // why the first comment didn't go up (the post itself is unaffected)
  coverSetAt      DateTime? // 1083: when the platform took the post's cover image
  coverError      String? // why the cover didn't go on (the post itself is unaffected)
  platformStatus  String    @default("pending") // pending | queued | uploading | processing | published | failed
  uploadRef       String? // platform upload handle between SOCIAL_UPLOAD and SOCIAL_PUBLISH
  platformPostId  String?
  platformUrl     String?
  errorCode       String?
  errorMessage    String?
  attempts        Int       @default(0)
  practice        Boolean   @default(false) // true = rehearsal through MockPublisher; never shown as a real post
  publishRequestedAt DateTime? // set just before the irreversible "go public" call; a retry reconciles first
  publishedAt     DateTime?
  // Taken down from the platform through Outlly. platformStatus stays "published" so history and stats stay true.
  removedAt       DateTime?
  removeMode      String? // deleted (gone from the platform) | hidden (YouTube: made private, can be made public again)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  post          Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount? @relation(fields: [socialAccountId], references: [id], onDelete: SetNull)
  metrics       TargetMetric[]

  @@unique([postId, platform])
  @@index([platformStatus])
}

model TargetMetric {
  id         String   @id @default(cuid())
  targetId   String
  capturedAt DateTime @default(now())
  views      Int      @default(0)
  likes      Int      @default(0)
  comments   Int      @default(0)
  shares     Int      @default(0)
  saves      Int      @default(0) // 1140: Instagram saves (0 on platforms that never report them)

  target PostTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@index([targetId, capturedAt])
}

/// A share-by-link review. The link is the credential, so only its SHA-256 hash is stored and
/// exactly one decision is ever accepted per token.
model ReviewRequest {
  id           String    @id @default(cuid())
  postId       String
  tokenHash    String    @unique
  reviewerName String?
  status       String    @default("pending") // pending | approved | changes_requested
  note         String?
  createdAt    DateTime  @default(now())
  decidedAt    DateTime?
  expiresAt    DateTime
  /// 1037: the team member who made the link (null = the owner). Their own change can't be cleared through it.
  createdById  String?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

/// Draft collaboration (1037): comments, edits and in-team approvals on one post, oldest first.
model PostNote {
  id         String   @id @default(cuid())
  postId     String
  authorId   String // the real person signed in (not the workspace owner when a member writes it)
  authorName String
  kind       String   @default("comment") // comment | edit | approved | changes
  body       String
  createdAt  DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

// ---------------------------------------------------------------- admin, billing, support (2026-10-12)

/// One row per user per active day (YYYY-MM-DD, UTC). Cheap DAU/WAU/MAU without an events table.
model UserActivityDay {
  id     String @id @default(cuid())
  userId String
  day    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([day])
}

/// Editable from /admin/pricing. Prices are minor units (paise / cents).
model Plan {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  priceMinor Int      @default(0)
  currency   String   @default("INR")
  interval   String   @default("month") // month | year
  yearlyMinor Int     @default(0) // yearly price in `currency` when interval is month; 0 = monthly x (12 - free months)
  note       String   @default("")
  features   String   @default("[]") // JSON string[]
  prices     String   @default("{}") // JSON { USD: 599, EUR: 549 } per-currency overrides; missing = converted from priceMinor
  postLimit  Int      @default(0) // posts per calendar month, 0 = unlimited
  aiCaptions Boolean  @default(true) // AI captions, hooks, titles and transcripts
  seats      Int      @default(0) // team members besides the owner, 0 = none
  postPeriod String   @default("month") // week | month: the window postLimit counts over
  maxUploadMb Int     @default(0) // per-file upload cap on this plan, 0 = the server maximum
  replyLimit Int      @default(0) // inbox replies per week (Monday 00:00 UTC), 0 = unlimited
  captionVideos Int   @default(0) // videos per month that can get AI captions, 0 = unlimited
  burnCaptions Boolean @default(true) // burn subtitles into the video file
  accountLimit Int    @default(0) // connected accounts in total (1037), several per platform allowed; 0 = one per platform
  state      String   @default("available") // available | soon | hidden
  highlight  Boolean  @default(false)
  sortOrder  Int      @default(0)
  storageMb  Int      @default(0) // total storage on this plan (1052), 0 = no cap
  yearlyPrices String @default("{}") // 1096: JSON { USD: 7000 } exact yearly prices per currency; missing = scaled from monthly
  platformLimit Int   @default(0) // 1096: different platforms that can be connected, 0 = any
  brandLimit Int      @default(0) // 1096: accounts per platform (a "brand" = one of each), 0 = accountLimit rules
  xPostLimit Int      @default(0) // 1096: posts to X per calendar month, 0 = unlimited; 1112: -1 = X is not on this plan
  analyticsDays Int   @default(0) // 1096: analytics history in days, 0 = the standard 90
  fairUsePosts Int    @default(0) // 1096: soft monthly ceiling on unlimited posts (admin alert, never a block), 0 = none
  perks      String   @default("") // 1096: JSON string[] of gated features; "" = every perk (plans made before 1096 keep everything)
  aiMonthly  Int      @default(0) // 1112: AI requests (hooks, ideas, rewrites, replies, reviews) per calendar month (UTC), 0 = no monthly cap
  aiDaily    Int      @default(0) // 1112: AI requests per UTC day, 0 = the server default (AI_DAILY_LIMIT)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  subscriptions Subscription[]
  grants        PlanGrant[]
}

/// Price is snapshotted, so editing a plan never silently changes what an existing subscriber pays.
model Subscription {
  id               String    @id @default(cuid())
  userId           String
  planId           String
  status           String    @default("active") // active | past_due | canceled
  priceMinor       Int
  currency         String
  interval         String
  provider         String
  currentPeriodEnd DateTime
  cancelAtPeriodEnd Boolean  @default(false)
  canceledAt       DateTime?
  pausedUntil      DateTime? // "pause for a month" instead of cancelling: no renewal charge until then
  autoRenew        Boolean   @default(false) // 1096: renews by itself (Razorpay Subscriptions / UPI Autopay mandate is live)
  providerSubId    String?   @unique // 1096: the gateway's subscription id while a mandate exists
  remindedFor      String? // 1096: last renewal reminder sent, "<periodEnd ms>:<days>"
  sample           Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([userId])
  @@index([status])
}

model Payment {
  id             String   @id @default(cuid())
  userId         String
  subscriptionId String?
  planId         String?
  amountMinor    Int
  currency       String
  provider       String // mock | stripe | razorpay
  interval       String   @default("month") // the billing cycle bought: month | year
  providerRef    String? // gateway payment / session id: the idempotency key
  status         String   @default("pending") // pending | succeeded | failed | refunded
  failureReason  String?
  sample         Boolean  @default(false)
  purpose        String   @default("plan") // 1096: plan | topup | renewal
  meta           String? // 1096: JSON, e.g. { pack, kind, units } for a top-up
  variant        String? // 1096: price-test variant this checkout was priced with
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  invoice      Invoice?

  @@unique([provider, providerRef])
  @@index([status, createdAt])
  @@index([userId])
}

/// Tax law needs invoices kept after the customer leaves, so deleting an account (or its payment row)
/// only detaches the invoice: userId and paymentId go null, detachedAt is set, and the retention cron
/// deletes it INVOICE_KEEP_YEARS after it was issued (lib/retention/prune.ts). Everything the PDF prints
/// is copied onto the row at issue time, so it renders the same without the payment or the user.
model Invoice {
  id            String    @id @default(cuid())
  number        String    @unique // OUT-2026-000123
  paymentId     String?   @unique
  userId        String?
  customerName  String
  customerEmail String
  description   String
  amountMinor   Int
  currency      String
  provider      String? // gateway at issue time (null on invoices issued before 2026-10-18)
  providerRef   String?
  taxPercent    Float? // tax rate at issue time
  issuer        String? // JSON {name,address,gstin} of the seller at issue time
  // 1121: what the redesigned PDF prints, copied at issue time from the payment and the gateway (null on older invoices)
  paidAt        DateTime? // when the gateway confirmed the payment
  periodStart   DateTime? // the subscription period this payment covers
  periodEnd     DateTime?
  method        String? // masked, e.g. "Visa debit •••• 4242", "UPI · ra•••@okhdfc"; never a full number
  lines         String? // JSON InvoiceLine[]: plan, add-ons, discounts, as charged
  issuedAt      DateTime  @default(now())
  emailedAt     DateTime?
  detachedAt    DateTime? // the customer deleted their account; kept for tax law until the retention window ends

  payment    Payment?    @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  creditNote CreditNote?

  @@index([userId, issuedAt])
}

/// 1049: issued when a paid invoice is refunded (GST needs one per refunded tax invoice). Full refunds only, so
/// one per invoice. Like the invoice, everything the PDF prints is copied at issue time, and it lives exactly as
/// long as its invoice (deleted with it by the retention cron).
model CreditNote {
  id            String    @id @default(cuid())
  number        String    @unique // CN-2026-000001
  invoiceId     String    @unique
  userId        String?
  customerName  String
  customerEmail String
  description   String
  amountMinor   Int
  currency      String
  reason        String?
  taxPercent    Float?
  issuer        String? // JSON {name,address,gstin} of the seller at issue time
  issuedAt      DateTime  @default(now())
  emailedAt     DateTime?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, issuedAt])
}

/// 1049: every time Pip reads someone's records (billing, posts, uploads, tickets). Filters only, never the data.
model PipAccessLog {
  id        String   @id @default(cuid())
  userId    String // whose data was read (the workspace owner)
  actorId   String? // the teammate who asked, when it wasn't the owner
  tool      String
  args      String // JSON of the filters used
  found     Int
  complete  Boolean
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// 1126: a signed-in person's Pip chat, kept so "Resolve & Send Transcript" emails what was really said.
/// Only the visible words: never records cards, tool output or the model's instructions. Pruned after 90 quiet days.
model PipConversation {
  id         String    @id @default(cuid())
  ref        String    @unique // C-7K2M9Q: the conversation ID printed on the transcript, safe to show
  userId     String // the person signed in (realUserId), so a teammate's chat is theirs, not the owner's
  subject    String
  status     String    @default("open") // open | resolved
  resolvedAt DateTime?
  sendingAt  DateTime? // a transcript email is on its way: a second send waits (no duplicate emails)
  sentAt     DateTime? // the last transcript that was delivered
  sentTo     String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages PipMessage[]

  @@index([userId, updatedAt])
  @@index([updatedAt])
}

model PipMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String // user | pip
  text           String
  createdAt      DateTime @default(now())

  conversation PipConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Ticket {
  id        String   @id @default(cuid())
  ref       String   @unique // T-7K2M9Q, safe to show the customer
  userId    String?
  email     String
  name      String?
  subject   String
  status    String   @default("open") // open | pending | resolved
  priority  String   @default("normal") // normal | high | urgent
  source    String   @default("chatbot") // chatbot | form | admin
  sample    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages TicketMessage[]

  @@index([status, priority, createdAt])
}

model TicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  author     String // customer | bot | admin
  authorName String?
  body       String
  createdAt  DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model FaqItem {
  id        String   @id @default(cuid())
  category  String // Payments | Account | Technical | Publishing
  question  String
  answer    String
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, sortOrder])
}

/// Every email we send or would send. With the mock provider this IS the outbox.
model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  html      String
  kind      String // invoice | ticket_opened | ticket_reply | test
  provider  String // mock | resend
  status    String // mocked | sent | failed | skipped (recipient unsubscribed from that list)
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// 10-26b: someone pressed Unsubscribe on a marketing email (or Gmail's one-click button did it for them).
/// Keyed by address, not user, so it also covers people without an account. Only "news" today: nudges,
/// win-back and growth campaigns. The weekly report has its own switch, User.weeklyReport.
model EmailOptOut {
  email     String // lower-case
  list      String // "news"
  createdAt DateTime @default(now())

  @@id([email, list])
}

/// Key/value config. Secret fields inside `value` are AES-256-GCM encrypted by lib/settings.ts.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AdminUser {
  id           String    @id @default(cuid())
  login        String    @unique
  name         String
  role         String    @default("support") // super | finance | support
  passwordHash String
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// Notification feed for the admin bell (failed payments, new subscriptions, new tickets).
model AdminEvent {
  id        String   @id @default(cuid())
  kind      String // payment_failed | subscription_new | ticket_new | ticket_urgent | plan_changed
  title     String
  body      String?
  href      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// One saved Gemini read of user behaviour. Every run is kept so admins can compare versions over time.
/// stats = the anonymised aggregate snapshot that was sent (JSON), result = the model's answer (JSON).
model BehaviorAnalysis {
  id         String   @id @default(cuid())
  version    Int      @unique
  rangeDays  Int      @default(30)
  focus      String?
  model      String?
  stats      String
  result     String
  createdBy  String
  durationMs Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// Someone the owner invited into their workspace. Members act on the owner's posts, media and accounts.
/// The invite link is the credential, so only its SHA-256 hash is stored.
model TeamMember {
  id         String    @id @default(cuid())
  ownerId    String
  userId     String?
  email      String
  role       String    @default("editor") // editor (drafts, needs approval) | manager (publish, schedule)
  accountIds String? // JSON string[] of SocialAccount ids this member may work on (1037); null = every account
  status     String    @default("invited") // invited | active
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  acceptedAt DateTime?

  owner User  @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  user  User? @relation("TeamSeat", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ownerId, email])
  @@index([userId])
}

/// Visitors who asked to be told when maintenance ends. Emailed once, then marked notified.
model MaintenanceSubscriber {
  id         String    @id @default(cuid())
  email      String    @unique
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?
}

/// People waiting for an invite while signups are paused (admin Waitlist switch). Emailed once when invited.
model WaitlistEntry {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  source    String?
  createdAt DateTime  @default(now())
  invitedAt DateTime?

  @@index([invitedAt, createdAt])
}

/// In-app alerts (reconnect, failed post, goal nudge). `key` dedupes, so a sweep can run every minute safely.
model Notice {
  id        String    @id @default(cuid())
  userId    String
  kind      String // token_expiring | post_failed | reconnect | goal_nudge | recycle | engagement_spike | draft_note
  tone      String    @default("info") // info | warn | danger
  title     String
  body      String
  href      String?
  action    String? // button label
  key       String    @unique
  readAt    DateTime?
  hiddenAt  DateTime? // cleared from history (1118). Kept, not deleted, so its key still stops a repeat
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

/// Reusable bits a creator builds up over time: caption presets, hashtag sets, templates, brand kit.
model Snippet {
  id        String   @id @default(cuid())
  userId    String
  kind      String // caption | hashtags | template | brand
  name      String
  body      String
  uses      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

/// Idea bank. Ideas come from the creator or from a comment in the inbox.
model Idea {
  id        String    @id @default(cuid())
  userId    String
  text      String
  source    String    @default("manual") // manual | comment | suggestion
  sourceRef String? // comment id or permalink
  doneAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, doneAt])
}

// Per-person daily AI call counter (Gemini costs money; the cap keeps one account from running up the bill).
model AiUsage {
  userId    String
  day       String // YYYY-MM-DD in UTC
  kind      String   @default("ai") // "ai" (writing help) | "support" (help chat)
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day, kind])
  @@index([day])
}

/// Metered plan features (inbox replies, caption videos). One row per use; `ref` dedupes, e.g. the
/// same video transcribed in several chunks counts once per period.
model FeatureUse {
  id        String   @id @default(cuid())
  userId    String
  feature   String // "reply" | "captions"
  period    String // "2026-W43" (weekly) or "2026-10" (monthly)
  ref       String
  topUpId   String? // 1096: this use was paid from a top-up pack, refunded to it on release
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, feature, period, ref])
  @@index([userId, feature, period])
}

/// One-time beta codes: the first N people to join get one, redeeming it unlocks a paid plan for a few months.
model BetaCode {
  id         String    @id @default(cuid())
  code       String    @unique
  planSlug   String    @default("creator")
  months     Int       @default(3)
  issuedToId String?   @unique // the early member it was issued to (null = made by hand in admin)
  note       String    @default("")
  redeemedById String? @unique // one redemption per code, and one beta grant per account
  redeemedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  issuedTo   User?     @relation("BetaIssued", fields: [issuedToId], references: [id], onDelete: SetNull)
  redeemedBy User?     @relation("BetaRedeemed", fields: [redeemedById], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

/// A phone running the Outlly Android app that may receive push notifications (FCM registration token).
model PushDevice {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  platform   String   @default("android")
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// 1118: a browser or installed web app (iPhone/iPad Home Screen, Android, desktop) that gets Web Push (VAPID).
/// Endpoint and keys are AES-256-GCM encrypted at rest and never leave the server; endpointHash is the lookup.
model WebPushSub {
  id           String    @id @default(cuid())
  userId       String
  endpointHash String    @unique
  endpoint     String
  p256dh       String
  auth         String
  /// The VAPID public key it was made with: a rotated key means the browser must subscribe again.
  vapidKey     String
  platform     String // ios | android | desktop
  device       String // "iPhone", "Android phone", "Windows PC"
  client       String // "Home Screen app", "Chrome", "Safari"
  installed    Boolean   @default(false)
  failures     Int       @default(0)
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  lastPushAt   DateTime?

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  outbox PushOutbox[]

  @@index([userId])
}

/// 1118: a Web Push the push service turned away for now (429, 5xx, no network), retried by the minute sweeper.
/// One row per device per notice, so a retry can never become a second notification.
model PushOutbox {
  id        String   @id @default(cuid())
  subId     String
  tag       String
  payload   String
  ttl       Int      @default(86400)
  urgency   String   @default("normal")
  attempts  Int      @default(1)
  nextAt    DateTime
  createdAt DateTime @default(now())

  sub WebPushSub @relation(fields: [subId], references: [id], onDelete: Cascade)

  @@unique([subId, tag])
  @@index([nextAt])
}

/// A direct-message conversation on a connected Instagram professional account or Facebook Page (1031).
/// One row per (account, person). Message text is AES-256-GCM encrypted at rest, like tokens.
model DmThread {
  id                String    @id @default(cuid())
  userId            String
  accountId         String
  platform          String // instagram | facebook
  /// Instagram-scoped (IGSID) or Page-scoped (PSID) id of the other person. Only meaningful to this account.
  participantId     String
  participantName   String?
  participantHandle String?
  participantAvatar String?
  /// Conversation id from the platform's conversations API, when known.
  platformThreadId  String?
  /// Encrypted preview of the newest message.
  snippet           String?
  lastMessageAt     DateTime
  /// When the person last wrote. Replies are only allowed for 24 hours after it.
  lastInboundAt     DateTime?
  unread            Int       @default(0)
  practice          Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  messages DmMessage[]

  @@unique([accountId, participantId])
  @@index([userId, lastMessageAt])
}

model DmMessage {
  id                String   @id @default(cuid())
  threadId          String
  /// The platform's message id (mid). Unique per thread so a webhook retry or an echo is stored once.
  platformMessageId String?
  direction         String // in | out
  /// Encrypted.
  text              String
  /// JSON [{ type, url }] for images, stickers, shares. URLs are the platform's, not copied.
  attachments       String?
  sentAt            DateTime
  /// Outlly user who replied from the studio (owner or a manager); null for messages sent in the platform's own app.
  sentById          String?
  createdAt         DateTime @default(now())

  thread DmThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, platformMessageId])
  @@index([threadId, sentAt])
}

/// Plan access that is not a paid subscription (1052): an admin grant or a referral reward. Never touches a
/// Subscription row, so revoking or expiring one can't cancel or change a paid plan. The best of all live
/// sources wins (lib/billing/access.ts). `userId` is null while an admin grant waits for that email to register.
model PlanGrant {
  id           String    @id @default(cuid())
  userId       String?
  email        String // lowercase address it was granted to
  planId       String
  source       String // admin | referral
  status       String    @default("active") // pending | active | revoked | expired (time decides "scheduled" / "running")
  startsAt     DateTime  @default(now())
  endsAt       DateTime
  durationDays Int? // granted by length: a pending grant's clock starts the day it activates
  note         String    @default("") // internal: why it was granted
  grantedBy    String? // admin login, or "system" for referral rewards
  revokedAt    DateTime?
  revokedBy    String?
  revokeReason String?
  liveKey      String?   @unique // "admin:<userId>" / "admin:@<email>" while an admin grant is live: one per person
  referralId   String?   @unique // one reward per referral
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  referral Referral? @relation(fields: [referralId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([email, status])
  @@index([status, endsAt])
}

/// Refer & Earn (1052). One row per friend: opened the link (invited), signed up (registered), first qualifying
/// payment verified (paid), Creator month issued (rewarded), or disqualified. The REFERRED friend gets the reward.
model Referral {
  id                 String    @id @default(cuid())
  referrerId         String
  referredId         String?   @unique // one referral per referred account
  code               String
  visitorKey         String?   @unique // the invite cookie, so an opened link becomes this row at signup
  status             String    @default("invited") // invited | registered | paid | rewarded | disqualified
  ipHash             String? // keyed hash of the network at signup (abuse checks), never the raw IP
  inboxKey           String? // the friend's folded inbox (Gmail dots / +tags), so one inbox is rewarded once
  flags              String    @default("") // comma list for admins: shared-network, burst
  paymentId          String?   @unique // the qualifying payment
  paidAt             DateTime?
  registeredAt       DateTime?
  disqualifiedAt     DateTime?
  disqualifiedReason String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  referrer User       @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User?      @relation("ReferralReceived", fields: [referredId], references: [id], onDelete: Cascade)
  grant    PlanGrant?

  @@index([referrerId, status])
  @@index([code])
  @@index([ipHash])
  @@index([inboxKey])
}

/// Audit trail of every administrative change to plans, grants and referrals (1052). Append-only.
model AuditLog {
  id         String   @id @default(cuid())
  actor      String // admin login, or "system"
  actorRole  String? // super | finance | support | marketing
  action     String // grant.create | grant.extend | grant.change | grant.revoke | grant.activate | grant.expire | referral.reward | referral.revoke | referral.config ...
  targetType String // grant | referral | config
  targetId   String?
  email      String? // whose access it was about (lowercase), so history can be searched by email
  before     String? // JSON snapshot
  after      String? // JSON snapshot
  note       String   @default("")
  createdAt  DateTime @default(now())

  @@index([email, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
}

/// An account deletion in progress (1053). The User row is gone the moment it is created; this is only what
/// the person's status link needs: no email, no name, just counts. Pruned 30 days after it finishes.
model AccountDeletion {
  id         String    @id @default(cuid())
  tokenHash  String    @unique // sha256 of the status link token, which only the person who deleted holds
  status     String    @default("running") // running | done | failed (failed = a file kept failing; staff alerted)
  filesTotal Int       @default(0)
  filesDone  Int       @default(0)
  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  files StorageCleanup[]

  @@index([status, createdAt])
}

/// One uploaded object to remove (a video, a thumbnail). Retried with backoff by the minute sweeper until it
/// is gone; removing an object that is already gone counts as done, so a retry can never do harm.
model StorageCleanup {
  id         String    @id @default(cuid())
  deletionId String?
  key        String
  attempts   Int       @default(0)
  nextAt     DateTime  @default(now())
  doneAt     DateTime?
  lastError  String?
  createdAt  DateTime  @default(now())

  deletion AccountDeletion? @relation(fields: [deletionId], references: [id], onDelete: Cascade)

  @@unique([deletionId, key])
  @@index([doneAt, nextAt])
}

/// 1096: a bought pack. ai/x packs are spent unit by unit after the plan allowance; brand/seat packs add room until expiresAt.
model TopUp {
  id        String   @id @default(cuid())
  userId    String
  kind      String // ai | x | brand | seat
  pack      String // pack id from the "topups" setting
  units     Int
  remaining Int
  paymentId String?  @unique
  status    String   @default("active") // active | refunded
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, status])
}

/// 1096: price test bookkeeping. One row per person, test and step (exposure | checkout | paid).
model ExperimentEvent {
  id         String   @id @default(cuid())
  experiment String
  variant    String
  userId     String
  kind       String
  amountMinor Int     @default(0)
  currency   String   @default("")
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([experiment, userId, kind])
  @@index([experiment, kind])
}

/// 1096: Van Westendorp price survey answers, in minor units of `currency`.
model SurveyResponse {
  id        String   @id @default(cuid())
  userId    String
  survey    String
  planSlug  String   @default("")
  currency  String   @default("INR")
  answers   String // JSON { tooCheap, cheap, expensive, tooExpensive, note? }
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, survey])
  @@index([survey])
}

/// 1096: why someone cancelled, and whether they will talk to us about it.
model CancelFeedback {
  id        String   @id @default(cuid())
  userId    String
  planSlug  String
  reason    String // one of CANCEL_REASONS (lib/billing/experiments-core.ts)
  detail    String   @default("")
  interview Boolean  @default(false)
  contact   String?
  status    String   @default("new") // new | contacted | done
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

/// 1122: a promo offer (flash sale). Admin-managed; the price is always worked out on the server from the real plan
/// price, so nothing about the offer is hardcoded in the app. Applied once, to the first payment of a listed plan.
model Campaign {
  id             String   @id @default(cuid())
  title          String
  kind           String   @default("pct") // pct | fixed
  value          Int      @default(0) // pct: 1-90 (percent off); fixed: minor units off, in `currency`
  currency       String   @default("INR") // fixed only: the currency `value` is in (other currencies don't get the offer)
  planSlugs      String   @default("[]") // JSON string[]: the plans it applies to; the first is the one the popup shows
  startsAt       DateTime
  endsAt         DateTime
  banner         String   @default("{}") // JSON { badge, headline, body, benefits: string[], terms }
  ctaText        String   @default("Claim Offer Now")
  ctaHref        String   @default("/billing") // a path inside the app; ?campaign=<id>&plan=<slug> is added
  eligibility    String   @default("all") // all | free | new | lapsed
  active         Boolean  @default(false)
  maxRedemptions Int      @default(0) // 0 = no cap
  redemptions    Int      @default(0) // paid conversions so far
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  events         CampaignEvent[]

  @@index([active, startsAt, endsAt])
}

/// 1122: what happened to an offer: impression | dismiss | click | conversion. One impression per person per day.
model CampaignEvent {
  id         String   @id @default(cuid())
  campaignId String
  userId     String?
  kind       String
  day        String   @default("") // YYYY-MM-DD (UTC), for the once-a-day impression rule; a conversion adds "#<paymentId>" (one row per payment)
  paymentId  String?
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId, kind, day]) // one impression / dismissal / click / conversion per person, offer and day
  @@index([campaignId, kind])
  @@index([userId, campaignId])
}

// ===== NOTIFY round 1141 =====
// The centralized notification engine's own tables. Nothing here replaces Notice: a Notice is still the one
// record of "this person was told this once" (its `key` is the unique one). These three sit around it:
// NotifyEvent in front (what happened, once, whatever retries the source makes), NotifyDelivery behind
// (what each channel actually did, including the skips and why), NotifyDeadLetter to the side (events the
// engine gave up on, kept so an admin can see them instead of losing them).

/// Something that happened and may be worth telling someone about. Written by webhooks, by the app and by
/// the sweeps; processed by lib/notify-engine.ts. `idemKey` is the source's own identity for the event
/// (a comment id, a slot and date, a payment id): a duplicate delivery writes nothing at all.
model NotifyEvent {
  id          String    @id @default(cuid())
  userId      String
  /// Event key from lib/notify-core.ts EVENTS, or an engine kind ("idle_30m", "greet_morning").
  kind        String
  /// Where it came from: "webhook:meta" | "app" | "sweep" | "platform" | "billing".
  source      String    @default("app")
  idemKey     String    @unique
  /// The connected account it concerns, when it concerns one.
  accountId   String?
  /// 1 urgent ... 4 quiet. Decides what survives a digest. lib/notify-core.ts priorityOf.
  priority    Int       @default(3)
  /// JSON the notice is built from. Only what the server verified itself; never a guess.
  payload     String    @default("{}")
  status      String    @default("pending") // pending | done | skipped | failed | dead
  attempts    Int       @default(0)
  lastError   String?
  nextAt      DateTime  @default(now())
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotifyDelivery[]

  @@index([status, nextAt])
  @@index([userId, createdAt])
  @@index([kind, createdAt])
}

/// What one channel did with one notification: sent, skipped (with the reason: switched off, quiet hours,
/// still inside a cooldown, notifications paused) or failed. The admin's delivery stats and failure list
/// read this; it is also the honest answer to "was I told about this?".
model NotifyDelivery {
  id        String   @id @default(cuid())
  userId    String
  eventId   String?
  /// The Notice this belongs to, when one was written.
  noticeId  String?
  kind      String
  /// Category from lib/notify-core.ts, so stats group without re-deriving it.
  category  String   @default("")
  channel   String // inapp | push | email | fcm
  status    String // sent | skipped | failed | queued
  /// Short machine reason for a skip or failure ("quiet_hours", "cooldown", "event_off", "paused", "no_device").
  reason    String?
  /// Anything a human needs to understand it. Never a secret, never a token.
  detail    String?
  createdAt DateTime @default(now())

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  event NotifyEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([kind, createdAt])
}

/// An event the engine could not process after its retries. Kept rather than dropped: a dead letter is a
/// bug to look at, and the payload is what makes it findable.
model NotifyDeadLetter {
  id        String   @id @default(cuid())
  userId    String?
  kind      String
  source    String   @default("")
  idemKey   String
  payload   String   @default("{}")
  error     String   @default("")
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([idemKey])
}


// ===== ANALYTICS round 1140 =====

/// One row per connected account per UTC day, written by the background metric sync from what that
/// platform's own API reports. No platform gives follower history, so Outlly keeps its own. Every number is
/// nullable: a metric the API did not return stays null and is shown as "Not available", never as 0.
model AccountSnapshot {
  id         String   @id @default(cuid())
  accountId  String
  day        String // YYYY-MM-DD in UTC
  followers  Int?
  posts      Int?
  views      Int? // the platform's own window, named by viewsScope; not a daily delta
  viewsScope String? // 28_days | recent_posts | lifetime
  capturedAt DateTime @default(now())

  account SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, day])
  @@index([accountId, day])
}

/// How the background metric sync is getting on with one account: when it last succeeded, what went wrong
/// last time, and how long the platform asked us to wait. Read by the UI to show a real "last synced" time.
model AccountSyncState {
  id            String    @id @default(cuid())
  accountId     String    @unique
  lastSyncAt    DateTime? // last run that wrote or confirmed numbers
  lastTriedAt   DateTime?
  lastError     String? // a short code (RATE_LIMITED, AUTH_EXPIRED, ...), never a token or body
  cooldownUntil DateTime? // set when the platform asked us to slow down
  targetsDone   Int       @default(0) // posts touched by the last run
  updatedAt     DateTime  @updatedAt

  account SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}
